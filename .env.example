# Configuração opcional: PowerShell $env:PORT='3210'
PORT=3210
# Nunca expor este servidor sem autenticação. O host é fixo em 127.0.0.1.
SALVOAI_DB=data/salvoai.sqlite
SALVOAI_MODEL=gemma3:1b
# Use 0 para coletar apenas prévias ao salvar novos links.
SALVOAI_AUTO_PROCESS=1

# Vercel: configure os valores reais no painel, nunca no Git.
SALVOAI_PUBLIC_URL=https://salvoai-ebon.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
